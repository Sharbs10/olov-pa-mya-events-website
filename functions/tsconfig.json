{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["es2020", "webworker"],      // ONLY webworker, NO dom
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "types": ["@cloudflare/workers-types"], // ONLY workers types
    "skipLibCheck": true
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "../node_modules"]
}